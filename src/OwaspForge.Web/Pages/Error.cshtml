@page
@model ErrorModel
@{ var english = Request.Path.StartsWithSegments("/en"); ViewData["Title"] = english ? "Safe interruption" : "Sicherer Unterbruch"; }
<section class="error-screen" aria-labelledby="error-title">
    <p class="eyebrow">@(english ? "System notice · local" : "Systemmeldung · lokal")</p>
    <h1 id="error-title">@(english ? "The lab flow was safely interrupted." : "Der Lab-Ablauf wurde sicher unterbrochen.")</h1>
    <p>@(english ? "No technical exception details were shown. Return to the learning path and try the station again." : "Es wurden keine Details der technischen Ausnahme angezeigt. Kehre zum Lernpfad zurück und versuche die Station erneut.")</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-id">@(english ? "Local reference:" : "Lokale Referenz:") <code>@Model.RequestId</code></p>
    }
    <a class="button button-solid" href="@(english ? "/en" : "/")">@(english ? "Back to learning path" : "Zum Lernpfad")</a>
</section>
