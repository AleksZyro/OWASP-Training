@page "/en"
@model EnglishIndexModel
@{ ViewData["Title"] = "Local security learning platform"; }
<section class="hero" aria-labelledby="page-title"><p class="eyebrow">Local learning environment</p><h1 id="page-title">Learn safely. Understand locally.</h1><p>OWASP Forge explains common web risks in a controlled sandbox. There are no scans, no external targets and no real credentials.</p><div class="notice" role="note"><strong>Security boundary:</strong> All examples are educational, local and labelled <em>intentionally vulnerable</em>. Challenge containers have no network by default.</div></section>
<section class="progress-panel" aria-label="Your learning progress"><div><p class="eyebrow">Your progress</p><strong>@Model.CompletedCount of @Model.Challenges.Count completed</strong></div><progress value="@Model.CompletedCount" max="@Model.Challenges.Count">@Model.CompletedCount of @Model.Challenges.Count</progress><span>@Model.TotalPoints / @Model.MaximumPoints points · not a certification</span></section>
<section aria-labelledby="challenges-title"><p class="eyebrow">MVP challenges</p><h2 id="challenges-title">Choose a topic</h2><div class="card-grid">@foreach (var item in Model.Challenges) { var status = Model.CompletedIds.Contains(item.Id) ? "Completed" : "Not started"; <article class="challenge-card"><div class="card-top"><span class="tag">@item.Category</span><span class="status @((status == "Completed") ? "done" : "open")">@status</span></div><h3>@item.Title</h3><p>@item.LearningGoal</p><dl><div><dt>Difficulty</dt><dd>@item.Difficulty</dd></div><div><dt>Time</dt><dd>@item.Duration</dd></div><div><dt>Points</dt><dd>@item.Points</dd></div></dl><a class="button secondary" href="/en/challenge/@item.Id">Open challenge <span aria-hidden="true">→</span></a></article> }</div></section>
