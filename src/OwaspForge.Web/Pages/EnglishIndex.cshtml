@page "/en"
@model EnglishIndexModel
@{ ViewData["Title"] = "Security Lab"; }
<section class="hero course-hero" aria-labelledby="page-title">
    <p class="eyebrow">OWASP Forge · local security lab</p>
    <h1 id="page-title">Security knowledge,<br />one step at a time.</h1>
    <p>Understand common web risks in a protected local learning environment. Every station shows what can go wrong – and which server-side measure protects it.</p>
    <div class="boundary-note" role="note"><strong>For local learning only</strong><span>localhost · isolated sandbox · no external scans · no real targets</span></div>
</section>

<section class="course-progress" aria-label="Your learning progress">
    <div><p class="eyebrow">Your learning path</p><h2>@Model.CompletedCount of @Model.Challenges.Count stations completed</h2><p class="progress-copy">Four courses · 72 questions · not a certification</p></div>
    <progress value="@Model.CompletedCount" max="@Model.Challenges.Count">@Model.CompletedCount of @Model.Challenges.Count</progress>
</section>

@if (Model.NextChallenge is not null)
{
    <section class="continue-course" aria-label="Next station">
        <div class="course-marker" aria-hidden="true">→</div>
        <div><p class="eyebrow">Up next</p><h2>@Model.NextChallenge.Title</h2><p>Continue with the next open station in your learning path.</p></div>
        <a class="button button-solid" href="/en/challenge/@Model.NextChallenge.Id">Continue</a>
    </section>
}
else
{
    <section class="continue-course complete-course" aria-label="Learning path complete">
        <div class="course-marker" aria-hidden="true">✓</div>
        <div><p class="eyebrow">Learning path complete</p><h2>All stations are secured</h2><p>You can revisit any station whenever you want.</p></div>
    </section>
}

<section class="course-section" aria-labelledby="challenges-title">
    <div class="section-heading"><div><p class="eyebrow">Course path</p><h2 id="challenges-title">Learn in clear topic blocks</h2></div><p>Every answer is verified on the server.</p></div>
    @foreach (var course in Model.Courses)
    {
        <section class="course-module" aria-labelledby="course-@course.Key.Replace(" ", "-").ToLowerInvariant()">
            <header class="course-module-header"><div><p class="eyebrow">@course.Key</p><h3 id="course-@course.Key.Replace(" ", "-").ToLowerInvariant()">Three stations · 18 questions</h3></div></header>
            <ol class="learning-path">
                @foreach (var item in course)
                {
                    var complete = Model.CompletedIds.Contains(item.Id);
                    var started = Model.StartedIds.Contains(item.Id);
                    var status = complete ? "Completed" : started ? "In progress" : "Ready";
                    var statusClass = complete ? "done" : started ? "active" : "open";
                    <li class="path-station @statusClass">
                        <article class="station-card">
                            <div class="station-topline"><span class="category">@item.Category</span><span class="status @statusClass">@status</span></div>
                            <h4>@item.Title</h4>
                            <p>@item.LearningGoal</p>
                            <div class="station-details"><span>@item.Difficulty</span><span>@item.Duration</span><span>6 questions</span></div>
                            <a class="station-link" href="/en/challenge/@item.Id">Open station <span aria-hidden="true">→</span></a>
                        </article>
                    </li>
                }
            </ol>
        </section>
    }
</section>
