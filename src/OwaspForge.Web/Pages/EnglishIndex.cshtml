@page "/en"
@model EnglishIndexModel
@{ ViewData["Title"] = "Security Lab"; }
<section class="hero" aria-labelledby="page-title"><p class="eyebrow">OWASP Forge · Security Lab</p><h1 id="page-title">Defensive knowledge.<br />Local control.</h1><p>A calm workshop for common web risks. Every station uses only local learning content – no scans, real targets or credentials.</p><div class="notice" role="note"><strong>Security boundary / 01</strong><br />localhost only. Isolated sandbox. No external network access. Historical variants are clearly labelled <em>intentionally vulnerable</em>.</div></section>
<section class="mission-status" aria-label="Your learning progress"><div><p class="eyebrow">Mission status</p><strong>@Model.CompletedCount / @Model.Challenges.Count stations secured</strong></div><progress value="@Model.CompletedCount" max="@Model.Challenges.Count">@Model.CompletedCount of @Model.Challenges.Count</progress><span>@Model.TotalPoints / @Model.MaximumPoints points<br />not a certification</span></section>
@if (Model.NextChallenge is not null) { <section class="next-station" aria-label="Recommended next station"><div><p class="eyebrow">Recommended next step</p><strong>@Model.NextChallenge.Title</strong><p>Continue at the next station that has not yet been secured.</p></div><a class="button button-solid" href="/en/challenge/@Model.NextChallenge.Id">Continue learning path →</a></section> } else { <section class="next-station complete-lab" aria-label="Learning path complete"><div><p class="eyebrow">Learning path complete</p><strong>All stations secured</strong><p>You can reset individual stations and work through them again at any time.</p></div></section> }
<section aria-labelledby="challenges-title"><div class="section-heading"><div><p class="eyebrow">Learning path</p><h2 id="challenges-title">Six controlled lab stations</h2></div><p>Select a station. Every check runs on the server.</p></div><div class="mission-list">@{ var index = 1; }@foreach (var item in Model.Challenges) { var complete = Model.CompletedIds.Contains(item.Id); var started = Model.StartedIds.Contains(item.Id); var status = complete ? "Secured" : started ? "In progress" : "Not started"; var statusClass = complete ? "done" : started ? "active" : "open"; <article class="mission-card"><span class="mission-index">@index.ToString("D2")</span><div><h3>@item.Title</h3><p>@item.LearningGoal</p><div class="mission-meta"><span>@item.Category</span><span>@item.Difficulty</span><span>@item.Duration</span><span>@item.Points points</span></div></div><div class="mission-action"><span class="status @statusClass">@status</span><a class="button" href="/en/challenge/@item.Id">Open station →</a></div></article> index++; }</div></section>
