@page "/en/challenge/{id}"
@model EnglishChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; }
<a class="back-link" href="/en">← All challenges</a><article class="challenge-detail"><header><p class="eyebrow">@Model.SelectedChallenge.Category · @Model.SelectedChallenge.Difficulty · @Model.SelectedChallenge.Duration</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></header>@if (success || Model.IsCompleted) { <div class="success" role="status"><strong>Completed.</strong> +@Model.SelectedChallenge.Points points</div> } @if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Not quite.</strong> @Model.Feedback</div> }<section><h2>Local demo</h2><div class="demo"><p><strong>Intentionally vulnerable:</strong> The historical version is for explanation only. It is not executed and never used against external systems.</p><p>@Model.SelectedChallenge.Explanation</p></div></section><div class="content-grid"><section><h2>Your task</h2><p>@Model.SelectedChallenge.Task</p><form method="post" asp-page-handler="Check"><fieldset><legend>Select the secure measure</legend>@foreach (var option in Model.SelectedChallenge.Options) { <label class="option"><input type="radio" name="answer" value="@option.Value" required /> @option.Label</label> }</fieldset><button class="button" type="submit">Check solution on the server</button></form></section><aside><h2>Impact</h2><p>@Model.SelectedChallenge.Impact</p><h2>After the fix</h2><p>@Model.SelectedChallenge.ExpectedAfterFix</p></aside></div><section><h2>Hints</h2><details><summary>Hint 1</summary><p>@Model.SelectedChallenge.Hints[0]</p></details><details><summary>Hint 2</summary><p>@Model.SelectedChallenge.Hints[1]</p></details></section><details><summary>Open solution explanation</summary><p>The browser does not decide correctness: the platform validates the rule on the server and stores progress locally.</p></details><form method="post" asp-page-handler="Reset"><button class="button danger" type="submit">Reset challenge</button></form><p><a href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Open official OWASP documentation</a></p></article>
