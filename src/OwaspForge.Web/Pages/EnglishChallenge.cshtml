@page "/en/challenge/{id}"
@model EnglishChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; var reset = Request.Query["reset"] == "true"; }
<a class="back-link" href="/en">← Back to course path</a>
<article>
    <header class="challenge-header">
        <div><p class="eyebrow">@Model.SelectedChallenge.Category</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></div>
        <dl class="challenge-facts"><div><dt>Difficulty</dt><dd>@Model.SelectedChallenge.Difficulty</dd></div><div><dt>Estimated time</dt><dd>@Model.SelectedChallenge.Duration</dd></div><div><dt>Local sandbox</dt><dd>@Model.SelectedChallenge.Id</dd></div></dl>
    </header>
    @if (Model.DemoUrl is not null) { <p class="demo-launch"><strong>Local demo:</strong> first run <code>docker compose --profile demos up --build</code>, then <a href="@Model.DemoUrl" target="_blank" rel="noreferrer">open the demo in a new tab</a>.</p> }
    @if (reset) { <div class="reset-confirmation" role="status" aria-live="polite"><strong>Station reset.</strong> Local progress was removed.</div> }
    @if (success || Model.IsCompleted) { <div class="success" role="status" aria-live="polite"><strong>Station secured.</strong> The protection rule was verified on the server. @Model.SelectedChallenge.Points points earned.</div><div class="completion-actions">@if (Model.NextChallenge is not null) { <a class="button button-solid" href="/en/challenge/@Model.NextChallenge.Id">Next station</a> }<a class="button" href="/en">View course path</a></div> }
    @if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Not quite yet.</strong> @Model.Feedback</div> }

    <ol class="lesson-flow">
        <li class="lesson-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Understand</p><h2>The local situation</h2><p class="body-copy">@Model.SelectedChallenge.Explanation</p><div class="risk-note"><strong>Intentionally vulnerable</strong><p>The historical variant is for explanation only. It is not executed and is never used against external systems.</p></div></section></li>
        <li class="lesson-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Put it in context</p><h2>Why it matters</h2><p class="body-copy">@Model.SelectedChallenge.Impact</p></section></li>
        <li class="lesson-step action-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Secure</p><h2>Choose the secure measure</h2><p class="body-copy">@Model.SelectedChallenge.Task</p><form method="post" asp-page-handler="Check" data-submit-form data-busy-label="Checking rule …"><fieldset><legend>Which rule protects this station?</legend>@foreach (var option in Model.SelectedChallenge.Options) { <label class="option"><input type="radio" name="answer" value="@option.Value" required /> <span>@option.Label</span></label> }</fieldset><button class="button button-solid" type="submit">Check answer</button></form></section></li>
        <li class="lesson-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Verify</p><h2>How do you recognise the fix?</h2><p class="body-copy">@Model.SelectedChallenge.ExpectedAfterFix</p><details class="hint"><summary>Show hint</summary><p>@Model.SelectedChallenge.Hints[0]</p></details><details class="hint"><summary>Another hint</summary><p>@Model.SelectedChallenge.Hints[1]</p></details></section></li>
        <li class="lesson-step final-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Learn from it</p><h2>Understand the solution</h2><details class="solution"><summary>Open solution explanation</summary><p>The browser never decides completion. OWASP Forge validates the selected protection rule on the server and stores progress only locally.</p></details></section></li>
    </ol>
    <div class="reset-row"><form method="post" asp-page-handler="Reset" data-submit-form data-busy-label="Resetting station …"><button class="button danger" type="submit">Reset station</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Official OWASP documentation ↗</a></div>
</article>
