@page "/en/challenge/{id}"
@model EnglishChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var reset = Request.Query["reset"] == "true"; }

<a class="back-link" href="/en">← Course overview</a>
<article class="lesson">
    <header class="challenge-header">
        <div>
            <p class="eyebrow">@Model.SelectedChallenge.Category</p>
            <h1>@Model.SelectedChallenge.Title</h1>
            <p class="lead">@Model.SelectedChallenge.LearningGoal</p>
        </div>
        <dl class="challenge-facts">
            <div><dt>Scope</dt><dd>@Model.SelectedChallenge.Duration</dd></div>
            <div><dt>Level</dt><dd>@Model.SelectedChallenge.Difficulty</dd></div>
        </dl>
    </header>

    @if (Model.DemoUrl is not null)
    {
        <p class="demo-launch"><strong>Local demo available.</strong> <a href="@Model.DemoUrl" target="_blank" rel="noreferrer">View it in a new tab</a></p>
    }

    @if (reset)
    {
        <div class="reset-confirmation" role="status" aria-live="polite">Station reset.</div>
    }

    @if (Model.IsCompleted)
    {
        <div class="success" role="status" aria-live="polite"><strong>Station complete.</strong> You applied the protection rule correctly. <span>@Model.EarnedPoints points</span></div>
        <div class="completion-actions">
            @if (Model.NextChallenge is not null) { <a class="button button-solid" href="/en/challenge/@Model.NextChallenge.Id">Next station</a> }
            <a class="button" href="/en">Course overview</a>
        </div>
    }

    @if (Model.Feedback is not null)
    {
        <div class="error" role="alert"><strong>Not quite yet.</strong> @Model.Feedback</div>
    }

    @if (!Model.ShowQuiz)
    {
        <section class="understand" aria-labelledby="context-title">
            <p class="section-kicker">Scenario</p>
            <h2 id="context-title">What happens in this example?</h2>
            <p class="body-copy">@Model.SelectedChallenge.Example.Context</p>

            <div class="lesson-brief">
                <section>
                    <p class="brief-label">Why it matters</p>
                    <p>@Model.SelectedChallenge.Impact</p>
                </section>
                <section>
                    <p class="brief-label">What to look for</p>
                    <p>@Model.SelectedChallenge.Task</p>
                </section>
            </div>

            <div class="example-panel">
                <section class="example-variant risky-example" aria-labelledby="risky-example-title">
                    <p id="risky-example-title">Historical variant <span>intentionally vulnerable</span></p>
                    <pre><code>@Model.SelectedChallenge.Example.RiskySnippet</code></pre>
                </section>
                <section class="example-variant safe-example" aria-labelledby="safe-example-title">
                    <p id="safe-example-title">Safer direction</p>
                    <pre><code>@Model.SelectedChallenge.Example.SaferSnippet</code></pre>
                </section>
            </div>

            <div class="explanation"><h3>Why this matters</h3><p>@Model.SelectedChallenge.Explanation</p></div>
            <div class="takeaway"><strong>Remember</strong><p>@Model.SelectedChallenge.Example.Takeaway</p></div>
            @if (Model.SelectedChallenge.Example.KeyPoints.Count > 0)
            {
                <section class="key-points" aria-labelledby="key-points-title">
                    <h3 id="key-points-title">Three things to remember</h3>
                    <ul>
                        @foreach (var point in Model.SelectedChallenge.Example.KeyPoints)
                        {
                            <li>@point</li>
                        }
                    </ul>
                </section>
            }
            <p class="expected"><strong>After the fix:</strong> @Model.SelectedChallenge.ExpectedAfterFix</p>
            @if (Model.SelectedChallenge.Protocol.IsAvailable)
            {
                <section class="protocol-evidence" aria-labelledby="protocol-title">
                    <p class="section-kicker">HTTP evidence</p>
                    <h3 id="protocol-title">What the server must decide</h3>
                    <dl>
                        <div><dt>Request</dt><dd><code>@Model.SelectedChallenge.Protocol.Method</code></dd></div>
                        <div><dt>Expected response</dt><dd><code>@Model.SelectedChallenge.Protocol.Status</code></dd></div>
                        <div><dt>Security signal</dt><dd>@Model.SelectedChallenge.Protocol.SecurityHeaders</dd></div>
                        <div><dt>Identity</dt><dd>@Model.SelectedChallenge.Protocol.AuthenticationState</dd></div>
                        <div><dt>Decision</dt><dd>@Model.SelectedChallenge.Protocol.AuthorizationResult</dd></div>
                    </dl>
                    <p>This is a local expected decision, not a network request.</p>
                </section>
            }
            <form method="post" asp-page-handler="Start"><button class="button button-solid" type="submit">Continue</button></form>
        </section>
    }
    else
    {
        <section class="decision" aria-labelledby="decision-title">
            <p class="section-kicker">Apply it</p>
            <h2 id="decision-title">Make your decision</h2>
            <p class="body-copy">Apply the example to the following situations.</p>
            <p class="score-note">Hints cost 10 points each; incorrect answers cost 15 points each. You can <a href="/en/challenge/@Model.SelectedChallenge.Id">read the scenario again</a>.</p>
            <form method="post" asp-page-handler="Check" data-submit-form data-busy-label="Reviewing …">
                <fieldset>
                    <legend>Which answer fits each situation?</legend>
                    @for (var questionIndex = 0; questionIndex < Model.SelectedChallenge.Questions.Count; questionIndex++)
                    {
                        var question = Model.SelectedChallenge.Questions[questionIndex];
                        <fieldset class="question-block">
                            <legend class="question-prompt"><span>@(questionIndex + 1)</span> @question.Prompt</legend>
                            @foreach (var option in question.Options)
                            {
                                <label class="option"><input type="radio" name="answers[@questionIndex]" value="@option.Value" required /> <span>@option.Label</span></label>
                            }
                        </fieldset>
                    }
                </fieldset>
                <button class="button button-solid" type="submit">Review answers</button>
            </form>
        </section>

        <aside class="help" aria-label="Hints">
            <h2>Need a nudge?</h2>
            @if (Model.HintsUsed == 0) { <form method="post" asp-page-handler="Hint" asp-route-level="1"><button class="text-button" type="submit">Open first hint <span>−10 points</span></button></form> }
            else { <p>@Model.SelectedChallenge.Hints[0]</p> }
            @if (Model.HintsUsed == 1) { <form method="post" asp-page-handler="Hint" asp-route-level="2"><button class="text-button" type="submit">Open second hint <span>−10 points</span></button></form> }
            else if (Model.HintsUsed >= 2) { <p>@Model.SelectedChallenge.Hints[1]</p> }
        </aside>

        @if (Model.CanSeeSolution)
        {
            <section class="solution"><h2>Why this solution works</h2><p>@Model.SelectedChallenge.SolutionExplanation</p></section>
        }
    }

    <div class="reset-row"><form method="post" asp-page-handler="Reset" data-submit-form data-busy-label="Resetting …"><button class="button danger" type="submit">Reset station</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">OWASP reference ↗</a></div>
</article>
