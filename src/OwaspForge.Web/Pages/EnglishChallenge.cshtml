@page "/en/challenge/{id}"
@model EnglishChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; var reset = Request.Query["reset"] == "true"; }
<a class="back-link" href="/en">← Back to course path</a>
<article><header class="challenge-header"><div><p class="eyebrow">@Model.SelectedChallenge.Category</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></div><dl class="challenge-facts"><div><dt>Difficulty</dt><dd>@Model.SelectedChallenge.Difficulty</dd></div><div><dt>Estimated time</dt><dd>@Model.SelectedChallenge.Duration</dd></div><div><dt>Local sandbox</dt><dd>@Model.SelectedChallenge.Id</dd></div></dl></header>
    @if (Model.DemoUrl is not null) { <p class="demo-launch"><strong>Local demo:</strong> <a href="@Model.DemoUrl" target="_blank" rel="noreferrer">Open demo</a></p> }
    @if (reset) { <div class="reset-confirmation" role="status" aria-live="polite"><strong>Station reset.</strong> Local progress and score penalties were removed.</div> }
    @if (success || Model.IsCompleted) { <div class="success" role="status" aria-live="polite"><strong>Station secured.</strong> Server check passed. <strong>@Model.EarnedPoints points</strong> earned@if (Model.PenaltyPoints > 0) { <span> (@Model.PenaltyPoints deducted for attempts/hints)</span> }.</div><div class="completion-actions">@if (Model.NextChallenge is not null) { <a class="button button-solid" href="/en/challenge/@Model.NextChallenge.Id">Next station</a> }<a class="button" href="/en">View course path</a></div> }
    @if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Not quite yet.</strong> Incorrect answers were scored. @Model.Feedback</div> }
    @if (!Model.ShowQuiz) { <section class="lesson-intro"><p class="eyebrow">Before you start</p><h2>Understand first, then decide</h2><p class="body-copy">Take a moment with the context. You will see why the historical variant is risky and what behaviour to expect after the fix.</p><div class="risk-note"><strong>Intentionally vulnerable</strong><p>@Model.SelectedChallenge.Explanation The historical variant is never executed or used against external systems.</p></div><div class="intro-grid"><div><strong>Security impact</strong><p>@Model.SelectedChallenge.Impact</p></div><div><strong>Expected behaviour</strong><p>@Model.SelectedChallenge.ExpectedAfterFix</p></div></div><a class="button button-solid" href="/en/challenge/@Model.SelectedChallenge.Id?step=quiz">Continue to the check</a></section> } else { <ol class="lesson-flow"><li class="lesson-step action-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Secure · @Model.QuestionCount questions</p><h2>Choose the secure measure</h2><p class="body-copy">The three questions build on each other. Answer all of them to complete the station.</p><p class="score-note">Possible points: @Model.SelectedChallenge.Points · Attempts: @Model.Attempts · Deducted: @Model.PenaltyPoints</p><form method="post" asp-page-handler="Check" data-submit-form data-busy-label="Checking rules …"><fieldset><legend>Which rule protects this station?</legend>@for (var questionIndex = 0; questionIndex < Model.SelectedChallenge.Questions.Count; questionIndex++) { <div class="question-block"><p class="question-prompt"><strong>@(questionIndex + 1).</strong> @Model.SelectedChallenge.Questions[questionIndex].Prompt</p>@foreach (var option in Model.SelectedChallenge.Options) { <label class="option"><input type="radio" name="answers[@questionIndex]" value="@option.Value" required /> <span>@option.Label</span></label> }</div> }</fieldset><button class="button button-solid" type="submit">Check answers</button></form></section></li><li class="lesson-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">After the check</p><h2>How do you recognise the fix?</h2><p class="body-copy">@Model.SelectedChallenge.ExpectedAfterFix</p>@if (Model.HintsUsed == 0) { <form method="post" asp-page-handler="Hint" asp-route-level="1"><button class="button hint-button" type="submit">Use first hint (−10 points)</button></form> } else { <details class="hint" open><summary>Hint 1</summary><p>@Model.SelectedChallenge.Hints[0]</p></details> } @if (Model.HintsUsed == 1) { <form method="post" asp-page-handler="Hint" asp-route-level="2"><button class="button hint-button" type="submit">Use second hint (−10 points)</button></form> } else if (Model.HintsUsed >= 2) { <details class="hint" open><summary>Hint 2</summary><p>@Model.SelectedChallenge.Hints[1]</p></details> }</section></li>@if (Model.CanSeeSolution) { <li class="lesson-step final-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Learn from it</p><h2>Understand the solution</h2><details class="solution" open><summary>Solution explanation</summary><p>The browser never decides completion. OWASP Forge validates the protection rule on the server and stores progress only locally.</p></details></section></li> }</ol> }
    <div class="reset-row"><form method="post" asp-page-handler="Reset" data-submit-form data-busy-label="Resetting station …"><button class="button danger" type="submit">Reset station</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Official OWASP documentation ↗</a></div></article>
