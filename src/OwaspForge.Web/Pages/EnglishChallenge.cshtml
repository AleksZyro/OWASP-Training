@page "/en/challenge/{id}"
@model EnglishChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; }
<a class="back-link" href="/en">← Back to learning path</a>
<article><header class="lab-header"><div><p class="eyebrow">Lab station · @Model.SelectedChallenge.Category</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></div><div class="lab-id">SANDBOX ID<strong>@Model.SelectedChallenge.Id</strong><br />@Model.SelectedChallenge.Difficulty · @Model.SelectedChallenge.Duration</div></header>@if (success || Model.IsCompleted) { <div class="success" role="status"><strong>Station secured.</strong> The server-side rule was confirmed. +@Model.SelectedChallenge.Points points</div> } @if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Check remains open.</strong> @Model.Feedback</div> }
<div class="challenge-flow"><div class="flow-main"><section class="lab-section"><p class="section-label"><span class="step-index">01</span> Understand the situation</p><h2>Local learning context</h2><div class="demo"><strong>Intentionally vulnerable</strong><p>The historical variant is for explanation only. It is never executed or used against external systems.</p><p>@Model.SelectedChallenge.Explanation</p></div></section><section class="lab-section"><p class="section-label"><span class="step-index">03</span> Select a secure measure</p><h2>Server-side check</h2><p>@Model.SelectedChallenge.Task</p><form method="post" asp-page-handler="Check"><fieldset><legend>Which rule protects this station?</legend>@foreach (var option in Model.SelectedChallenge.Options) { <label class="option"><input type="radio" name="answer" value="@option.Value" required /> @option.Label</label> }</fieldset><button class="button" type="submit">Check rule on the server →</button></form></section><section class="lab-section"><p class="section-label"><span class="step-index">05</span> Understand the solution</p><details class="solution"><summary>Open solution explanation</summary><p>The browser never decides completion. OWASP Forge validates the selected protection rule on the server and stores progress only locally.</p></details></section></div><aside class="flow-side"><section class="side-panel"><p class="section-label"><span class="step-index">02</span> Security impact</p><h2>What is the risk?</h2><p>@Model.SelectedChallenge.Impact</p></section><section class="side-panel"><p class="section-label"><span class="step-index">04</span> Expected state</p><h2>After the fix</h2><p>@Model.SelectedChallenge.ExpectedAfterFix</p></section><section class="side-panel"><p class="section-label">Evidence</p><h2>Hints</h2><details><summary>Hint 01</summary><p>@Model.SelectedChallenge.Hints[0]</p></details><details><summary>Hint 02</summary><p>@Model.SelectedChallenge.Hints[1]</p></details></section></aside></div><div class="reset-row"><form method="post" asp-page-handler="Reset"><button class="button danger" type="submit">Reset station</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Official OWASP documentation ↗</a></div></article>
