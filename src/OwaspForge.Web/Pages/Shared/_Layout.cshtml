@{
    var english = Context.Request.Path.StartsWithSegments("/en");
    var challengeId = Context.Request.RouteValues["id"] as string;
    var germanTarget = english && !string.IsNullOrWhiteSpace(challengeId) ? $"/Challenge/{challengeId}" : "/";
    var englishTarget = !english && !string.IsNullOrWhiteSpace(challengeId) ? $"/en/challenge/{challengeId}" : "/en";
}
<!DOCTYPE html>
<html lang="@(english ? "en" : "de-CH")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · OWASP Forge</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/lab.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main">@(english ? "Skip to content" : "Zum Inhalt springen")</a>
    <header class="site-header">
        <a class="brand" href="@(english ? "/en" : "/")" aria-label="OWASP Forge Startseite"><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M20 3 34 8v10c0 9-5.5 15.3-14 19C11.5 33.3 6 27 6 18V8l14-5Z"/><path d="m14 21 4 4 9-10"/></svg><span class="brand-name">OWASP <b>Forge</b></span></a>
        <nav class="language-switch" aria-label="@(english ? "Language" : "Sprache")">
            <a class="language-link" href="@germanTarget" aria-current="@(!english ? "page" : null)">DE</a>
            <a class="language-link" href="@englishTarget" aria-current="@(english ? "page" : null)">EN</a>
        </nav>
        <span class="local-badge">@(english ? "localhost only" : "nur localhost")</span>
    </header>
    <main id="main" class="shell">@RenderBody()</main>
    <footer>OWASP Forge · @(english ? "local defensive learning lab · not a certification" : "lokales defensives Lernlabor · keine Zertifizierung") · <a class="footer-link" href="/privacy?lang=@(english ? "en" : "de")">@(english ? "Privacy" : "Datenschutz")</a></footer>
</body>
</html>
