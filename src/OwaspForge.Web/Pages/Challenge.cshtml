@page "{id}"
@model ChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; var reset = Request.Query["reset"] == "true"; var hint = Request.Query["hint"].ToString(); }
<a class="back-link" asp-page="/Index">← Zum Kursweg</a>
<article>
    <header class="challenge-header"><div><p class="eyebrow">@Model.SelectedChallenge.Category</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></div><dl class="challenge-facts"><div><dt>Schwierigkeit</dt><dd>@Model.SelectedChallenge.Difficulty</dd></div><div><dt>Arbeitszeit</dt><dd>@Model.SelectedChallenge.Duration</dd></div><div><dt>Lokale Sandbox</dt><dd>@Model.SelectedChallenge.Id</dd></div></dl></header>
    @if (Model.DemoUrl is not null) { <p class="demo-launch"><strong>Lokale Demo:</strong> <a href="@Model.DemoUrl" target="_blank" rel="noreferrer">Demo öffnen</a></p> }
    @if (reset) { <div class="reset-confirmation" role="status" aria-live="polite"><strong>Station zurückgesetzt.</strong> Der lokale Fortschritt und die Punkteabzüge wurden entfernt.</div> }
    @if (success || Model.IsCompleted) { <div class="success" role="status" aria-live="polite"><strong>Station gesichert.</strong> Serverprüfung bestanden. <strong>@Model.EarnedPoints Punkte</strong> erreicht@if (Model.PenaltyPoints > 0) { <span> (@Model.PenaltyPoints Abzug durch Versuche/Hinweise)</span> }.</div><div class="completion-actions">@if (Model.NextChallenge is not null) { <a class="button button-solid" asp-page="/Challenge" asp-route-id="@Model.NextChallenge.Id">Nächste Station</a> }<a class="button" asp-page="/Index">Kursweg ansehen</a></div> }
    @if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Noch nicht ganz.</strong> Die falschen Antworten wurden bewertet. @Model.Feedback</div> }

    @if (!Model.ShowQuiz)
    {
        <section class="lesson-intro"><p class="eyebrow">Bevor du startest</p><h2>Erst verstehen, dann entscheiden</h2><p class="body-copy">Nimm dir Zeit für den Kontext. Du siehst zuerst, was die historische Variante riskant macht und welches Verhalten nach dem Fix erwartet wird.</p><div class="risk-note"><strong>Intentionally vulnerable</strong><p>@Model.SelectedChallenge.Explanation Die historische Variante wird nie ausgeführt und nie gegen fremde Systeme eingesetzt.</p></div><div class="intro-grid"><div><strong>Sicherheitsauswirkung</strong><p>@Model.SelectedChallenge.Impact</p></div><div><strong>Erwartetes Verhalten</strong><p>@Model.SelectedChallenge.ExpectedAfterFix</p></div></div><a class="button button-solid" asp-page="/Challenge" asp-route-id="@Model.SelectedChallenge.Id" asp-route-step="quiz">Weiter zur Prüfung</a></section>
    }
    else
    {
        <ol class="lesson-flow"><li class="lesson-step action-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Absichern · @Model.QuestionCount Fragen</p><h2>Wähle die sichere Massnahme</h2><p class="body-copy">Die Fragen bauen aufeinander auf. Jede Frage hat eigene Antwortoptionen und wird erst auf dem Server bewertet.</p><p class="score-note">Hinweise und Fehlversuche reduzieren die erreichbaren Punkte. Deine Antworten bleiben lokal.</p><form method="post" asp-page-handler="Check" data-submit-form data-busy-label="Regeln werden geprüft …"><fieldset><legend>Welche Regel schützt diese Station?</legend>@for (var questionIndex = 0; questionIndex < Model.SelectedChallenge.Questions.Count; questionIndex++) { var question = Model.SelectedChallenge.Questions[questionIndex]; <div class="question-block"><p class="question-prompt"><strong>@(questionIndex + 1).</strong> @question.Prompt</p>@foreach (var option in question.Options) { <label class="option"><input type="radio" name="answers[@questionIndex]" value="@option.Value" required /> <span>@option.Label</span></label> }</div> }</fieldset><button class="button button-solid" type="submit">Antworten prüfen</button></form></section></li><li class="lesson-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Nach dem Check</p><h2>Woran erkennst du den Fix?</h2><p class="body-copy">@Model.SelectedChallenge.ExpectedAfterFix</p>@if (Model.HintsUsed == 0) { <form method="post" asp-page-handler="Hint" asp-route-level="1"><button class="button hint-button" type="submit">Ersten Hinweis nutzen (−10 Punkte)</button></form> } else { <details class="hint" open><summary>Hinweis 1</summary><p>@Model.SelectedChallenge.Hints[0]</p></details> } @if (Model.HintsUsed == 1) { <form method="post" asp-page-handler="Hint" asp-route-level="2"><button class="button hint-button" type="submit">Zweiten Hinweis nutzen (−10 Punkte)</button></form> } else if (Model.HintsUsed >= 2) { <details class="hint" open><summary>Hinweis 2</summary><p>@Model.SelectedChallenge.Hints[1]</p></details> }</section></li>@if (Model.CanSeeSolution) { <li class="lesson-step final-step"><div class="lesson-node" aria-hidden="true"></div><section><p class="eyebrow">Nachvollziehen</p><h2>Die Lösung verstehen</h2><details class="solution" open><summary>Lösungserklärung</summary><p>@Model.SelectedChallenge.SolutionExplanation</p></details></section></li> }</ol>
    }
    <div class="reset-row"><form method="post" asp-page-handler="Reset" data-submit-form data-busy-label="Station wird zurückgesetzt …"><button class="button danger" type="submit">Station zurücksetzen</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Offizielle OWASP-Dokumentation ↗</a></div>
</article>
