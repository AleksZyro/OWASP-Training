@page "{id}"
@model ChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var reset = Request.Query["reset"] == "true"; }

<a class="back-link" asp-page="/Index">← Kursübersicht</a>
<article class="lesson">
    <header class="challenge-header">
        <div>
            <p class="eyebrow">@Model.SelectedChallenge.Category</p>
            <h1>@Model.SelectedChallenge.Title</h1>
            <p class="lead">@Model.SelectedChallenge.LearningGoal</p>
        </div>
        <dl class="challenge-facts">
            <div><dt>Umfang</dt><dd>@Model.SelectedChallenge.Duration</dd></div>
            <div><dt>Niveau</dt><dd>@Model.SelectedChallenge.Difficulty</dd></div>
        </dl>
    </header>

    @if (Model.DemoUrl is not null)
    {
        <p class="demo-launch"><strong>Lokale Demo verfügbar.</strong> <a href="@Model.DemoUrl" target="_blank" rel="noreferrer">In neuem Tab ansehen</a></p>
    }

    @if (reset)
    {
        <div class="reset-confirmation" role="status" aria-live="polite">Station zurückgesetzt.</div>
    }

    @if (Model.IsCompleted)
    {
        <div class="success" role="status" aria-live="polite"><strong>Station abgeschlossen.</strong> Du hast die Schutzregel korrekt angewendet. <span>@Model.EarnedPoints Punkte</span></div>
        <div class="completion-actions">
            @if (Model.NextChallenge is not null) { <a class="button button-solid" asp-page="/Challenge" asp-route-id="@Model.NextChallenge.Id">Nächste Station</a> }
            <a class="button" asp-page="/Index">Kursübersicht</a>
        </div>
    }

    @if (Model.Feedback is not null)
    {
        <div class="error" role="alert"><strong>Noch nicht ganz.</strong> @Model.Feedback</div>
    }

    @if (!Model.ShowQuiz)
    {
        <section class="understand" aria-labelledby="context-title">
            <p class="section-kicker">Ausgangslage</p>
            <h2 id="context-title">Was passiert in diesem Beispiel?</h2>
            <p class="body-copy">@Model.SelectedChallenge.Example.Context</p>

            <div class="lesson-brief">
                <section>
                    <p class="brief-label">Warum das wichtig ist</p>
                    <p>@Model.SelectedChallenge.Impact</p>
                </section>
                <section>
                    <p class="brief-label">Worauf du achten solltest</p>
                    <p>@Model.SelectedChallenge.Task</p>
                </section>
            </div>

            <div class="example-panel">
                <section class="example-variant risky-example" aria-labelledby="risky-example-title">
                    <p id="risky-example-title">Historische Variante <span>intentionally vulnerable</span></p>
                    <pre><code>@Model.SelectedChallenge.Example.RiskySnippet</code></pre>
                </section>
                <section class="example-variant safe-example" aria-labelledby="safe-example-title">
                    <p id="safe-example-title">Sichere Richtung</p>
                    <pre><code>@Model.SelectedChallenge.Example.SaferSnippet</code></pre>
                </section>
            </div>

            <div class="explanation"><h3>Warum das zählt</h3><p>@Model.SelectedChallenge.Explanation</p></div>
            <div class="takeaway"><strong>Merksatz</strong><p>@Model.SelectedChallenge.Example.Takeaway</p></div>
            @if (Model.SelectedChallenge.Example.KeyPoints.Count > 0)
            {
                <section class="key-points" aria-labelledby="key-points-title">
                    <h3 id="key-points-title">Drei Dinge zum Mitnehmen</h3>
                    <ul>
                        @foreach (var point in Model.SelectedChallenge.Example.KeyPoints)
                        {
                            <li>@point</li>
                        }
                    </ul>
                </section>
            }
            <p class="expected"><strong>Nach dem Fix:</strong> @Model.SelectedChallenge.ExpectedAfterFix</p>
            @if (Model.SelectedChallenge.Protocol.IsAvailable)
            {
                <section class="protocol-evidence" aria-labelledby="protocol-title">
                    <p class="section-kicker">HTTP-Evidenz</p>
                    <h3 id="protocol-title">Was der Server entscheiden muss</h3>
                    <dl>
                        <div><dt>Anfrage</dt><dd><code>@Model.SelectedChallenge.Protocol.Method</code></dd></div>
                        <div><dt>Erwartete Antwort</dt><dd><code>@Model.SelectedChallenge.Protocol.Status</code></dd></div>
                        <div><dt>Schutzsignal</dt><dd>@Model.SelectedChallenge.Protocol.SecurityHeaders</dd></div>
                        <div><dt>Identität</dt><dd>@Model.SelectedChallenge.Protocol.AuthenticationState</dd></div>
                        <div><dt>Entscheid</dt><dd>@Model.SelectedChallenge.Protocol.AuthorizationResult</dd></div>
                    </dl>
                    <p>Diese Übersicht beschreibt eine lokale erwartete Entscheidung; sie löst keine Netzwerk-Anfrage aus.</p>
                </section>
            }
            <form method="post" asp-page-handler="Start"><button class="button button-solid" type="submit">Weiter</button></form>
        </section>
    }
    else
    {
        <section class="decision" aria-labelledby="decision-title">
            <p class="section-kicker">Anwenden</p>
            <h2 id="decision-title">Triff deine Entscheidung</h2>
            <p class="body-copy">Übertrage das Beispiel auf die folgenden Situationen.</p>
            <p class="score-note">Hinweise kosten je 10 Punkte, falsche Antworten je 15 Punkte. Du kannst die Ausgangslage <a asp-page="/Challenge" asp-route-id="@Model.SelectedChallenge.Id">nochmals lesen</a>.</p>
            <form method="post" asp-page-handler="Check" data-submit-form data-busy-label="Wird ausgewertet …">
                <fieldset>
                    <legend>Welche Antwort passt jeweils?</legend>
                    @for (var questionIndex = 0; questionIndex < Model.SelectedChallenge.Questions.Count; questionIndex++)
                    {
                        var question = Model.SelectedChallenge.Questions[questionIndex];
                        <fieldset class="question-block">
                            <legend class="question-prompt"><span>@(questionIndex + 1)</span> @question.Prompt</legend>
                            @foreach (var option in question.Options)
                            {
                                <label class="option"><input type="radio" name="answers[@questionIndex]" value="@option.Value" required /> <span>@option.Label</span></label>
                            }
                        </fieldset>
                    }
                </fieldset>
                <button class="button button-solid" type="submit">Auswerten</button>
            </form>
        </section>

        <aside class="help" aria-label="Hinweise">
            <h2>Wenn du festhängst</h2>
            @if (Model.HintsUsed == 0) { <form method="post" asp-page-handler="Hint" asp-route-level="1"><button class="text-button" type="submit">Ersten Hinweis öffnen <span>−10 Punkte</span></button></form> }
            else { <p>@Model.SelectedChallenge.Hints[0]</p> }
            @if (Model.HintsUsed == 1) { <form method="post" asp-page-handler="Hint" asp-route-level="2"><button class="text-button" type="submit">Zweiten Hinweis öffnen <span>−10 Punkte</span></button></form> }
            else if (Model.HintsUsed >= 2) { <p>@Model.SelectedChallenge.Hints[1]</p> }
        </aside>

        @if (Model.CanSeeSolution)
        {
            <section class="solution"><h2>Warum diese Lösung funktioniert</h2><p>@Model.SelectedChallenge.SolutionExplanation</p></section>
        }
    }

    <div class="reset-row"><form method="post" asp-page-handler="Reset" data-submit-form data-busy-label="Wird zurückgesetzt …"><button class="button danger" type="submit">Station zurücksetzen</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">OWASP-Referenz ↗</a></div>
</article>
