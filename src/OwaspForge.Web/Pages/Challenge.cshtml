@page "{id}"
@model ChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; var reset = Request.Query["reset"] == "true"; }
<a class="back-link" asp-page="/Index">← Zurück zum Lernpfad</a>
<article><header class="lab-header"><div><p class="eyebrow">Lab-Station · @Model.SelectedChallenge.Category</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></div><div class="lab-id">SANDBOX-ID<strong>@Model.SelectedChallenge.Id</strong><br />@Model.SelectedChallenge.Difficulty · @Model.SelectedChallenge.Duration</div></header>@if (reset) { <div class="reset-confirmation" role="status" aria-live="polite"><strong>Station zurückgesetzt.</strong> Der lokale Fortschritt wurde entfernt; du kannst die Station erneut bearbeiten.</div> } @if (success || Model.IsCompleted) { <div class="success" role="status" aria-live="polite"><strong>Station gesichert.</strong> Die serverseitige Regel wurde bestätigt. +@Model.SelectedChallenge.Points Punkte</div><div class="completion-actions">@if (Model.NextChallenge is not null) { <a class="button button-solid" asp-page="/Challenge" asp-route-id="@Model.NextChallenge.Id">Nächste Station: @Model.NextChallenge.Title →</a> }<a class="button" asp-page="/Index">Lernpfad ansehen</a></div> } @if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Prüfung noch offen.</strong> @Model.Feedback</div> }
<div class="challenge-flow"><div class="flow-main"><section class="lab-section"><p class="section-label"><span class="step-index">01</span> Situation verstehen</p><h2>Lokaler Lernkontext</h2><div class="demo"><strong>Intentionally vulnerable</strong><p>Die historische Variante dient nur der Erklärung. Sie wird weder ausgeführt noch gegen fremde Systeme eingesetzt.</p><p>@Model.SelectedChallenge.Explanation</p></div></section><section class="lab-section"><p class="section-label"><span class="step-index">03</span> Sichere Massnahme auswählen</p><h2>Serverseitige Prüfung</h2><p>@Model.SelectedChallenge.Task</p><form method="post" asp-page-handler="Check" data-submit-form data-busy-label="Regel wird geprüft …"><fieldset><legend>Welche Regel schützt diese Station?</legend>@foreach (var option in Model.SelectedChallenge.Options) { <label class="option"><input type="radio" name="answer" value="@option.Value" required /> @option.Label</label> }</fieldset><button class="button" type="submit">Regel serverseitig prüfen →</button></form></section><section class="lab-section"><p class="section-label"><span class="step-index">05</span> Lösung nachvollziehen</p><details class="solution"><summary>Lösungserklärung öffnen</summary><p>Der Browser entscheidet nie über den Abschluss. OWASP Forge validiert die gewählte Schutzregel auf dem Server und speichert den Fortschritt nur lokal.</p></details></section></div><aside class="flow-side"><section class="side-panel"><p class="section-label"><span class="step-index">02</span> Sicherheitsauswirkung</p><h2>Was wäre das Risiko?</h2><p>@Model.SelectedChallenge.Impact</p></section><section class="side-panel"><p class="section-label"><span class="step-index">04</span> Erwarteter Zustand</p><h2>Nach dem Fix</h2><p>@Model.SelectedChallenge.ExpectedAfterFix</p></section><section class="side-panel"><p class="section-label">Evidenz</p><h2>Hinweise</h2><details><summary>Hinweis 01</summary><p>@Model.SelectedChallenge.Hints[0]</p></details><details><summary>Hinweis 02</summary><p>@Model.SelectedChallenge.Hints[1]</p></details></section></aside></div><div class="reset-row"><form method="post" asp-page-handler="Reset" data-submit-form data-busy-label="Station wird zurückgesetzt …"><button class="button danger" type="submit">Station zurücksetzen</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Offizielle OWASP-Dokumentation ↗</a></div></article>
