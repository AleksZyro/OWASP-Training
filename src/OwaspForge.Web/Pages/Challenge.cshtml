@page "{id}"
@model ChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; var reset = Request.Query["reset"] == "true"; }
<a class="back-link" asp-page="/Index">← Zum Kursweg</a>
<article>
    <header class="challenge-header">
        <div><p class="eyebrow">@Model.SelectedChallenge.Category</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></div>
        <dl class="challenge-facts"><div><dt>Schwierigkeit</dt><dd>@Model.SelectedChallenge.Difficulty</dd></div><div><dt>Arbeitszeit</dt><dd>@Model.SelectedChallenge.Duration</dd></div><div><dt>Lokale Sandbox</dt><dd>@Model.SelectedChallenge.Id</dd></div></dl>
    </header>
    @if (reset) { <div class="reset-confirmation" role="status" aria-live="polite"><strong>Station zurückgesetzt.</strong> Der lokale Fortschritt wurde entfernt.</div> }
    @if (success || Model.IsCompleted) { <div class="success" role="status" aria-live="polite"><strong>Station gesichert.</strong> Die Schutzregel wurde serverseitig bestätigt. @Model.SelectedChallenge.Points Punkte gesammelt.</div><div class="completion-actions">@if (Model.NextChallenge is not null) { <a class="button button-solid" asp-page="/Challenge" asp-route-id="@Model.NextChallenge.Id">Nächste Station</a> }<a class="button" asp-page="/Index">Kursweg ansehen</a></div> }
    @if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Noch nicht ganz.</strong> @Model.Feedback</div> }

    <ol class="lesson-flow">
        <li class="lesson-step">
            <div class="lesson-node" aria-hidden="true"></div>
            <section><p class="eyebrow">Verstehen</p><h2>Die lokale Situation</h2><p class="body-copy">@Model.SelectedChallenge.Explanation</p><div class="risk-note"><strong>Intentionally vulnerable</strong><p>Die historische Variante dient ausschliesslich der Erklärung. Sie wird nicht ausgeführt und nie gegen fremde Systeme eingesetzt.</p></div></section>
        </li>
        <li class="lesson-step">
            <div class="lesson-node" aria-hidden="true"></div>
            <section><p class="eyebrow">Einordnen</p><h2>Warum das wichtig ist</h2><p class="body-copy">@Model.SelectedChallenge.Impact</p></section>
        </li>
        <li class="lesson-step action-step">
            <div class="lesson-node" aria-hidden="true"></div>
            <section><p class="eyebrow">Absichern</p><h2>Wähle die sichere Massnahme</h2><p class="body-copy">@Model.SelectedChallenge.Task</p><form method="post" asp-page-handler="Check" data-submit-form data-busy-label="Regel wird geprüft …"><fieldset><legend>Welche Regel schützt diese Station?</legend>@foreach (var option in Model.SelectedChallenge.Options) { <label class="option"><input type="radio" name="answer" value="@option.Value" required /> <span>@option.Label</span></label> }</fieldset><button class="button button-solid" type="submit">Antwort prüfen</button></form></section>
        </li>
        <li class="lesson-step">
            <div class="lesson-node" aria-hidden="true"></div>
            <section><p class="eyebrow">Überprüfen</p><h2>Woran erkennst du den Fix?</h2><p class="body-copy">@Model.SelectedChallenge.ExpectedAfterFix</p><details class="hint"><summary>Hinweis anzeigen</summary><p>@Model.SelectedChallenge.Hints[0]</p></details><details class="hint"><summary>Weiterer Hinweis</summary><p>@Model.SelectedChallenge.Hints[1]</p></details></section>
        </li>
        <li class="lesson-step final-step">
            <div class="lesson-node" aria-hidden="true"></div>
            <section><p class="eyebrow">Nachvollziehen</p><h2>Die Lösung verstehen</h2><details class="solution"><summary>Lösungserklärung öffnen</summary><p>Der Browser entscheidet nie über den Abschluss. OWASP Forge validiert die gewählte Schutzregel auf dem Server und speichert den Fortschritt nur lokal.</p></details></section>
        </li>
    </ol>
    <div class="reset-row"><form method="post" asp-page-handler="Reset" data-submit-form data-busy-label="Station wird zurückgesetzt …"><button class="button danger" type="submit">Station zurücksetzen</button></form><a class="owasp-link" href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Offizielle OWASP-Dokumentation ↗</a></div>
</article>
