@page "{id}"
@model ChallengeModel
@{ ViewData["Title"] = Model.SelectedChallenge!.Title; var success = Request.Query["solved"] == "true"; }
<a class="back-link" asp-page="/Index">← Alle Challenges</a>
<article class="challenge-detail">
<header><p class="eyebrow">@Model.SelectedChallenge.Category · @Model.SelectedChallenge.Difficulty · @Model.SelectedChallenge.Duration</p><h1>@Model.SelectedChallenge.Title</h1><p class="lead">@Model.SelectedChallenge.LearningGoal</p></header>
@if (success || Model.IsCompleted) { <div class="success" role="status"><strong>Abgeschlossen.</strong> +@Model.SelectedChallenge.Points Punkte</div> }
@if (Model.Feedback is not null) { <div class="error" role="alert"><strong>Noch nicht ganz.</strong> @Model.Feedback</div> }
<section><h2>Lokale Demo</h2><div class="demo"><p><strong>Intentionally vulnerable:</strong> Die historische Variante dient nur der Erklärung und wird weder ausgeführt noch gegen fremde Systeme eingesetzt.</p><p>@Model.SelectedChallenge.Explanation</p></div></section>
<div class="content-grid"><section><h2>Deine Aufgabe</h2><p>@Model.SelectedChallenge.Task</p><form method="post" asp-page-handler="Check"><fieldset><legend>Sichere Massnahme auswählen</legend>@foreach (var option in Model.SelectedChallenge.Options) { <label class="option"><input type="radio" name="answer" value="@option.Value" required /> @option.Label</label> }</fieldset><button class="button" type="submit">Lösung serverseitig prüfen</button></form></section><aside><h2>Auswirkung</h2><p>@Model.SelectedChallenge.Impact</p><h2>Nach dem Fix</h2><p>@Model.SelectedChallenge.ExpectedAfterFix</p></aside></div>
<section><h2>Hinweise</h2><details><summary>Hinweis 1</summary><p>@Model.SelectedChallenge.Hints[0]</p></details><details><summary>Hinweis 2</summary><p>@Model.SelectedChallenge.Hints[1]</p></details></section>
<details><summary>Lösungserklärung öffnen</summary><p>Die richtige Regel wird nicht dem Browser überlassen: Die Plattform prüft die gewählte Schutzmassnahme serverseitig und speichert den Fortschritt lokal.</p></details>
<form method="post" asp-page-handler="Reset"><button class="button danger" type="submit">Challenge zurücksetzen</button></form><p><a href="@Model.SelectedChallenge.OfficialUrl" rel="noreferrer">Offizielle OWASP-Dokumentation öffnen</a></p>
</article>
