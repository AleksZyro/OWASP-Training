@page
@model IndexModel
@{ ViewData["Title"] = "Security Lab"; }
<section class="hero" aria-labelledby="page-title"><p class="eyebrow">OWASP Forge · Security Lab</p><h1 id="page-title">Defensives Wissen.<br />Lokale Kontrolle.</h1><p>Eine ruhige Werkstatt für typische Webrisiken. Jede Station arbeitet nur mit lokalen Lerninhalten – ohne Scans, reale Ziele oder echte Zugangsdaten.</p><div class="notice" role="note"><strong>Sicherheitsgrenze / 01</strong><br />Nur localhost. Isolierte Sandbox. Kein externer Netzwerkzugriff. Historische Varianten sind klar als <em>intentionally vulnerable</em> gekennzeichnet.</div></section>
<section class="mission-status" aria-label="Dein Lernfortschritt"><div><p class="eyebrow">Missionsstatus</p><strong>@Model.CompletedCount / @Model.Challenges.Count Stationen gesichert</strong></div><progress value="@Model.CompletedCount" max="@Model.Challenges.Count">@Model.CompletedCount von @Model.Challenges.Count</progress><span>@Model.TotalPoints / @Model.MaximumPoints Punkte<br />keine Zertifizierung</span></section>
@if (Model.NextChallenge is not null) { <section class="next-station" aria-label="Nächste empfohlene Station"><div><p class="eyebrow">Empfohlener nächster Schritt</p><strong>@Model.NextChallenge.Title</strong><p>Setze den Lernpfad an der nächsten noch nicht gesicherten Station fort.</p></div><a class="button button-solid" asp-page="/Challenge" asp-route-id="@Model.NextChallenge.Id">Lernpfad fortsetzen →</a></section> } else { <section class="next-station complete-lab" aria-label="Lernpfad abgeschlossen"><div><p class="eyebrow">Lernpfad abgeschlossen</p><strong>Alle Stationen gesichert</strong><p>Du kannst einzelne Stationen jederzeit zurücksetzen und nochmals durcharbeiten.</p></div></section> }
<section aria-labelledby="challenges-title"><div class="section-heading"><div><p class="eyebrow">Lernpfad</p><h2 id="challenges-title">Sechs kontrollierte Lab-Stationen</h2></div><p>Wähle eine Station. Jeder Check läuft serverseitig.</p></div><div class="mission-list">@{ var index = 1; }@foreach (var item in Model.Challenges) { var complete = Model.CompletedIds.Contains(item.Id); var started = Model.StartedIds.Contains(item.Id); var status = complete ? "Gesichert" : started ? "In Bearbeitung" : "Nicht begonnen"; var statusClass = complete ? "done" : started ? "active" : "open"; <article class="mission-card"><span class="mission-index">@index.ToString("D2")</span><div><h3>@item.Title</h3><p>@item.LearningGoal</p><div class="mission-meta"><span>@item.Category</span><span>@item.Difficulty</span><span>@item.Duration</span><span>@item.Points Punkte</span></div></div><div class="mission-action"><span class="status @statusClass">@status</span><a class="button" asp-page="/Challenge" asp-route-id="@item.Id">Station öffnen →</a></div></article> index++; }</div></section>
