@page
@model IndexModel
@{ ViewData["Title"] = "Security Lab"; }
<section class="hero" aria-labelledby="page-title"><p class="eyebrow">OWASP Forge · Security Lab</p><h1 id="page-title">Defensives Wissen.<br />Lokale Kontrolle.</h1><p>Eine ruhige Werkstatt für typische Webrisiken. Jede Station arbeitet nur mit lokalen Lerninhalten – ohne Scans, reale Ziele oder echte Zugangsdaten.</p><div class="notice" role="note"><strong>Sicherheitsgrenze / 01</strong><br />Nur localhost. Isolierte Sandbox. Kein externer Netzwerkzugriff. Historische Varianten sind klar als <em>intentionally vulnerable</em> gekennzeichnet.</div></section>
<section class="mission-status" aria-label="Dein Lernfortschritt"><div><p class="eyebrow">Missionsstatus</p><strong>@Model.CompletedCount / @Model.Challenges.Count Stationen gesichert</strong></div><progress value="@Model.CompletedCount" max="@Model.Challenges.Count">@Model.CompletedCount von @Model.Challenges.Count</progress><span>@Model.TotalPoints / @Model.MaximumPoints Punkte<br />keine Zertifizierung</span></section>
<section aria-labelledby="challenges-title"><div class="section-heading"><div><p class="eyebrow">Lernpfad</p><h2 id="challenges-title">Sechs kontrollierte Lab-Stationen</h2></div><p>Wähle eine Station. Jeder Check läuft serverseitig.</p></div><div class="mission-list">@{ var index = 1; }@foreach (var item in Model.Challenges) { var complete = Model.CompletedIds.Contains(item.Id); <article class="mission-card"><span class="mission-index">@index.ToString("D2")</span><div><h3>@item.Title</h3><p>@item.LearningGoal</p><div class="mission-meta"><span>@item.Category</span><span>@item.Difficulty</span><span>@item.Duration</span><span>@item.Points Punkte</span></div></div><div class="mission-action"><span class="status @(complete ? "done" : "open")">@(complete ? "Gesichert" : "Bereit")</span><a class="button" asp-page="/Challenge" asp-route-id="@item.Id">Station öffnen →</a></div></article> index++; }</div></section>
