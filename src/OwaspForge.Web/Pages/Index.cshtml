@page
@model IndexModel
@{ ViewData["Title"] = "Lokale Security-Lernplattform"; }
<section class="hero" aria-labelledby="page-title"><p class="eyebrow">Lokale Lernumgebung</p><h1 id="page-title">Sicher lernen. Lokal verstehen.</h1><p>OWASP Forge erklärt typische Webrisiken in einer kontrollierten Sandbox. Es gibt keine Scans, keine externen Ziele und keine echten Zugangsdaten.</p><div class="notice" role="note"><strong>Sicherheitsgrenze:</strong> Alle Beispiele sind didaktisch, lokal und als <em>intentionally vulnerable</em> gekennzeichnet. Challenge-Container haben standardmässig kein Netzwerk.</div></section>
<section class="progress-panel" aria-label="Dein Lernfortschritt"><div><p class="eyebrow">Dein Fortschritt</p><strong>@Model.CompletedCount von @Model.Challenges.Count abgeschlossen</strong></div><progress value="@Model.CompletedCount" max="@Model.Challenges.Count">@Model.CompletedCount von @Model.Challenges.Count</progress><span>@Model.TotalPoints / @Model.MaximumPoints Punkte · keine Zertifizierung</span></section>
<section aria-labelledby="challenges-title"><div class="section-title"><div><p class="eyebrow">MVP-Challenges</p><h2 id="challenges-title">Wähle ein Thema</h2></div></div><div class="card-grid">@foreach (var item in Model.Challenges) { var status = Model.CompletedIds.Contains(item.Id) ? "Abgeschlossen" : "Nicht begonnen"; <article class="challenge-card"><div class="card-top"><span class="tag">@item.Category</span><span class="status @((status == "Abgeschlossen") ? "done" : "open")">@status</span></div><h3>@item.Title</h3><p>@item.LearningGoal</p><dl><div><dt>Schwierigkeit</dt><dd>@item.Difficulty</dd></div><div><dt>Zeit</dt><dd>@item.Duration</dd></div><div><dt>Punkte</dt><dd>@item.Points</dd></div></dl><a class="button secondary" asp-page="/Challenge" asp-route-id="@item.Id">Challenge öffnen <span aria-hidden="true">→</span></a></article> }</div></section>
